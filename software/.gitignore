# ==============================================================================
# End-to-End Battery State Estimator Project .gitignore
# ==============================================================================

# ── Secrets and Environment Configurations ────────────────────────────────────
.env
.env.*
!.env.example

# ── Python Caches & Bytecode ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.cover

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── C / C++ Compiler Outputs & Executables ────────────────────────────────────
build/
dist/
*.egg-info/
*.o
*.obj
*.exe
*.out
*.elf
*.map
*.bin
*.d
*.a
*.lib
*.so
*.dll
*.dylib
*.gch
*.pch

# ── Xilinx Vivado & XSim FPGA Build/Simulation Artifacts ─────────────────────
.Xil/
xsim.dir/
*.jou
*.pb
*.str
*.wdb
*.vcd
*.bak
xsim.log
vivado.log

# ── Local Database & Runtime Telemetry Logs ──────────────────────────────────
*.log
*.db
*.sqlite
*.sqlite3
mongo_data/
data/db/

# ── Temporary & Scratch Files ─────────────────────────────────────────────────
tmp/
temp/
scratch/
*.tmp

# ── IDEs, Code Editors & OS Files ──────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.vs/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── Explicitly Tracked Model & Dataset Exception Rules ─────────────────────────
!hardware/STM_Verifier/esn_classifier_weights.h
!hardware/STM_Verifier/esn_estimator_weights.h
!software/visualiser/model_rc.pkl
!hardware/STM_Verifier/original_ev_battery_dataset_multiclass.csv
!hardware/STM_Verifier/training_ev_battery_dataset_multiclass.csv
!hardware/FPGA_Verifier/*.csv
!hardware/FPGA_Verifier/*.coe
!hardware/FPGA_Verifier/*.mem

