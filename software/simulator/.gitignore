# ==============================================================================
# Simulator Subsystem .gitignore
# ==============================================================================

# ── Secrets and Environment Configurations ────────────────────────────────────
.env
.env.*
!.env.example

# ── Python Caches & Bytecode ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.cover

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── C / C++ Compiler Outputs & Executables ────────────────────────────────────
build/
dist/
*.egg-info/
*.o
*.obj
*.exe
*.out
*.elf
*.map
*.bin
*.d
*.a
*.lib
*.so
*.dll
*.dylib
*.gch
*.pch

# ── Local Database & Runtime Telemetry Logs ──────────────────────────────────
*.log
*.db
*.sqlite
*.sqlite3
mongo_data/
data/db/

# ── Temporary & Scratch Files ─────────────────────────────────────────────────
tmp/
temp/
scratch/
*.tmp

# ── IDEs, Code Editors & OS Files ──────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.vs/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

