# Battery State Estimator - Physics Engine Environment Configuration Template
# Copy this file to .env for local overrides.
# NEVER commit real passwords or credentials to git repository.

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net
MONGODB_DB_NAME=battery_estimation_db
MONGODB_READINGS_COLLECTION=readings
MONGODB_STATE_COLLECTION=sim_state

PORT=8000
FLASK_DEBUG=False
SIMULATION_STEP_DELAY=1.0
API_KEY=change_this_to_a_secure_random_key_in_production

DEFAULT_NOISE_VOLTAGE=0.005
DEFAULT_NOISE_CURRENT=0.05
DEFAULT_NOISE_TEMPERATURE=0.2
