wr 0x08 2                  ;# ESN CLEAR
wr 0x08 4                  ;# ESN STREAM_EN
wr [expr {$F + 0x08}] 0xA5 ;# reset TX FIFO
wr [expr {$F + 0x18}] 0xA5 ;# reset RX FIFO
