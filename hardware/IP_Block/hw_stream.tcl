  set hi "0x[rd [expr {$F + 0x20}]]"
  set soc [format %04X [expr {$lo & 0xFFFF}]]
  set st  [expr {($lo >> 16) & 0x3F}]
  set g [lindex $gold $t]
  set ok [expr {$soc eq $g && $st == $t}]
  if {!$ok} { incr bad }
