    set sh [format %04X [expr {$hi & 0xFFFF}]]
    set sok [expr {$sh eq $goldsoh}]
    if {!$sok} { incr bad }
    puts $out "step 63 soc=$soc gold=$g SOH=$sh gold=$goldsoh [expr {$ok && $sok ? "OK" : "MISMATCH"}]"
