# ==============================================================================
# Battery State Estimator - Central Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the repository root or respective service folders:
#   cp .env.example .env
#
# NOTE: The system works 100% out-of-the-box in offline/in-memory mode with zero
# configuration if MongoDB Atlas credentials are not provided.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloud Database Settings (Optional - MongoDB Atlas)
# ------------------------------------------------------------------------------
# When left unset or unreachable, the system automatically falls back to an
# internal high-performance in-memory ring buffer (rolling 1,000 samples).
MONGODB_URI=
MONGODB_DB_NAME=battery_estimation_db
MONGODB_READINGS_COLLECTION=readings
MONGODB_STATE_COLLECTION=sim_state
MONGODB_SYNC_INTERVAL=1.0

# ------------------------------------------------------------------------------
# 2. Service Network Ports & Deployment Mode
# ------------------------------------------------------------------------------
# Physics Simulator Port
SIMULATOR_PORT=8000

# Web Visualiser Dashboard Port
VISUALISER_PORT=5000

# Set to True only for development debugging
FLASK_DEBUG=False

# URL used by Visualiser to poll or control the Simulator (default: http://localhost:8000)
SIMULATOR_URL=http://localhost:8000

# Optional API authentication key for administrative POST routes
API_KEY=

# ------------------------------------------------------------------------------
# 3. Physics Simulation Constants & Sensor Noise
# ------------------------------------------------------------------------------
# Real-time pacing interval (seconds per simulated timestep)
SIMULATION_STEP_DELAY=1.0

# Gaussian sensor noise standard deviations
DEFAULT_NOISE_VOLTAGE=0.005      # Volts (0.005 V = 5 mV)
DEFAULT_NOISE_CURRENT=0.05       # Amperes (0.05 A = 50 mA)
DEFAULT_NOISE_TEMPERATURE=0.2    # Degrees Celsius

# ------------------------------------------------------------------------------
# 4. Machine Learning & Estimator Pipeline
# ------------------------------------------------------------------------------
MODEL_PATH=software/visualiser/model_rc.pkl
CSV_PATH=software/visualiser/datasets/training_ev_battery_dataset_multiclass.csv
FEATURE_ROLLING_WINDOW=5
ESN_WASHOUT_STEPS=50
ESN_PRIMING_STEPS=50
ENABLE_ESN_STANDALONE=False

